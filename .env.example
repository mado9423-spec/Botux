# Copy to `.env` (which is git-ignored) ONLY if/when you move beyond paper trading.
# Paper trading and backtesting need NO keys at all: the bot never reads these
# variables unless live trading has been explicitly armed (see docs/LIVE_TRADING_CHECKLIST.md).
#
# All values below are placeholders. Never put real keys in this file.

# Binance API key pair. Create a key with:  Enable Reading + Enable Spot trading ONLY.
#   - Withdrawals:      OFF  (the bot refuses keys that allow withdrawal)
#   - Internal/universal transfer, Margin, Futures, Options: OFF
#   - IP restriction:   ON   (whitelist the machine that runs the bot)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Optional: path to the (non-secret) TOML settings file. Default: config/botux.toml,
# falling back to config/botux.example.toml.
# BOTUX_CONFIG=config/botux.toml
